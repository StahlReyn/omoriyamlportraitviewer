{
	"name": "omoriyamlportraitviewer",
	"displayName": "Omori Portrait YAML Viewer",
	"description": "Displays portrait in tool tips based from yaml",
	"version": "1.2.0",
	"engines": {
		"vscode": "^1.125.0"
	},
	"categories": [
		"Programming Languages",
		"Visualization",
		"Formatters",
		"Other"
	],
	"icon": "icon.png",
	"publisher": "ReynStahl",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/StahlReyn/omoriyamlportraitviewer.git"
	},
	"activationEvents": [
		"onLanguage:yaml"
	],
	"main": "./out/src/extension.js",
	"contributes": {
		"hoverProvider": [
			{
				"for": [
					"yaml"
				],
				"type": "markdown"
			}
		],
		"configuration": {
			"title": "Omori Portrait YAML Viewer",
			"properties": {
				"omoriYamlPortraitViewer.enableMacroHighlight": {
					"type": "boolean",
					"default": true,
					"description": "Enables the macro highlight feature."
				},
				"omoriYamlPortraitViewer.enablePortraitPreview": {
					"type": "boolean",
					"default": true,
					"description": "Enables the portrait view on highlight."
				},
				"omoriYamlPortraitViewer.portraitPath": {
					"type": "string",
					"default": "../../img/faces/",
					"description": "The path to the faceset image folder."
				},
				"omoriYamlPortraitViewer.macroDocsOverrides": {
					"type": "object",
					"markdownDescription": "Override or add custom macro documentation keys. Workspace rules will override global user rules.",
					"default": {},
					"additionalProperties": {
						"type": "object",
						"required": ["title", "desc"],
						"properties": {
						"title": { "type": "string", "description": "The title of the command/macro." },
						"desc": { "type": "string", "description": "Detailed description of what it does." },
						"source": { "type": "string", "description": "Origin of the macro data." }
						}
					}
				},
				"omoriYamlPortraitViewer.replacementMacrosOverrides": {
					"type": "object",
					"markdownDescription": "Override or add simple replacement macros. These are similar to plugin parameter macros.",
					"default": {},
					"additionalProperties": {
						"type": "string",
						"markdownDescription": "The text string value that replaces the macro key."
					}
				}
			}
		},
		"commands": [
			{
				"command": "omoriYamlPortraitViewer.openPreview",
				"title": "Open Dialogue YAML Preview",
				"category": "Preview"
			}
		],
		"keybindings": [
			{
				"command": "omoriYamlPortraitViewer.openPreview",
				"key": "ctrl+p",
				"mac": "cmd+p",
				"when": "editorTextFocus"
			}
		]
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@types/vscode": "^1.125.0",
		"@vscode/vsce": "^2.32.0",
		"typescript": "^7.0.2"
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./"
	},
	"dependencies": {
		"js-yaml": "^5.2.1"
	}
}
